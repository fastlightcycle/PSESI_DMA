digraph Interconnect_Done_Job_FSM {
    node [shape=circle];
    
    Idle [style=filled, fillcolor="#ffffff"];
    Request [style=filled, fillcolor="#ffffff"];

    Idle -> Idle [label=<<o>Valid_Request</o>>];
    Idle -> Request [label=<Valid_Request>];

    Request -> Request [label=<<o>GNT</o>>];
    Request -> Write_AD_Job_prev [label=<GNT &middot; Done_Job>];

    Write_AD_Job_prev -> Write_AD_Job_next_DT_NULL [label=<Done_Empty>];
    Write_AD_Job_prev -> Write_DT_DON_prev_AD_DON_prev_next [label=<<o>Done_Empty</o>>];

    Write_DT_DON_prev_AD_DON_prev_next -> Write_DT_DON_prev_AD_DON_prev_next [label=<WAIT>];
    Write_DT_DON_prev_AD_DON_prev_next -> Write_DT_Job_AD_Don_prev [label=<READY>];
    Write_DT_DON_prev_AD_DON_prev_next -> Error [label=<ERROR>];
    Write_DT_DON_prev_AD_DON_prev_next -> Retract [label=<RETRACT>];

    Write_DT_Job_AD_Don_prev -> Write_DT_Job_AD_Don_prev [label=<WAIT>];
    Write_DT_Job_AD_Don_prev -> Write_DT_Job_AD_Job_Next [label=<READY>];
    Write_DT_Job_AD_Don_prev -> Error [label=<ERROR>];
    Write_DT_Job_AD_Don_prev -> Retract [label=<RETRACT>];

    Write_DT_Job_AD_Job_Next -> Write_DT_Job_AD_Job_Next [label=<WAIT>];
    Write_DT_Job_AD_Job_Next -> Write_DT_DON_AD_DON [label=<READY>];
    Write_DT_Job_AD_Job_Next -> Error [label=<ERROR>];
    Write_DT_Job_AD_Job_Next -> Retract [label=<RETRACT>];

    Write_AD_Job_next_DT_NULL -> Write_AD_Job_next_DT_NULL [label=<WAIT>];
    Write_AD_Job_next_DT_NULL -> Write_DT_DON_AD_DON [label=<READY>];
    Write_AD_Job_next_DT_NULL -> Error [label=<ERROR>];
    Write_AD_Job_next_DT_NULL -> Retract [label=<RETRACT>];

    Write_DT_DON_AD_DON -> Write_DT_DON_AD_DON [label=<WAIT>];
    Write_DT_DON_AD_DON -> Write_DT_Job_AD_Job_status [label=<READY>];
    Write_DT_DON_AD_DON -> Error [label=<ERROR>];
    Write_DT_DON_AD_DON -> Retract [label=<RETRACT>];

    Write_DT_Job_AD_Job_status -> Write_DT_Job_AD_Job_status [label=<WAIT>];
    Write_DT_Job_AD_Job_status -> Write_DT_Done_AD_DON_LCK [label=<READY>];
    Write_DT_Job_AD_Job_status -> Error [label=<ERROR>];
    Write_DT_Job_AD_Job_status -> Retract [label=<RETRACT>];

    Write_DT_Done_AD_DON_LCK -> Write_DT_Done_AD_DON_LCK [label=<WAIT>];
    Write_DT_Done_AD_DON_LCK -> Write_DT_0 [label=<READY>];
    Write_DT_Done_AD_DON_LCK -> Error [label=<ERROR>];
    Write_DT_Done_AD_DON_LCK -> Retract [label=<RETRACT>];

    Write_DT_0 -> Write_DT_0 [label=<WAIT>];
    Write_DT_0 -> OK [label=<READY>];
    Write_DT_0 -> Error [label=<ERROR>];
    Write_DT_0 -> Retract [label=<RETRACT>];

    Error -> Idle;
    Retract -> Idle;
    OK -> Idle;
}
