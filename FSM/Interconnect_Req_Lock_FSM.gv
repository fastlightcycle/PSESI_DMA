digraph Interconnect_Req_Lock_FSM {
    node [shape=circle];
    
    Idle [style=filled, fillcolor="#ffffff"];
    Request [style=filled, fillcolor="#ffffff"];

    Idle -> Idle [label=<<o>Valid_Request</o>>];
    Idle -> Request [label=<Valid_Request>];

    Request -> Request [label=<<o>GNT</o>>];
    Request -> Read_AD_Lock [label=<GNT &middot; Req_Lock>];
    
    Read_AD_Lock -> Read_DT_Lock;

    Read_DT_Lock -> Read_DT_Lock [label=<WAIT>];
    Read_DT_Lock -> Error [label=<ERROR>];
    Read_DT_Lock -> Retract [label=<RETRACT>];
    Read_DT_Lock -> Check_Lock [label=<READY>];

    Check_Lock -> OK [label=<LCK>];
    Check_Lock -> Write_AD_Lock [label=<<o>LCK</o>>];

    Write_AD_Lock -> Write_DT_Lock;

    Write_DT_Lock -> Write_DT_Lock [label=<WAIT>];
    Write_DT_Lock -> OK [label=<READY>];
    Write_DT_Lock -> Error [label=<ERROR>];
    Write_DT_Lock -> Retract [label=<RETRACT>];

    Error -> Idle;
    Retract -> Idle;
    OK -> Idle;
}
