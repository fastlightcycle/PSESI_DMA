digraph Interconnect_Get_Job_FSM {
    node [shape=circle];
    
    Idle [style=filled, fillcolor="#ffffff"];
    Request [style=filled, fillcolor="#ffffff"];

    Idle -> Idle [label=<<o>Valid_Request</o>>];
    Idle -> Request [label=<Valid_Request>];

    Request -> Request [label=<<o>GNT</o>>];
    Request -> Read_AD_PND_next [label=<GNT &middot; Get_Job>];

    Read_AD_PND_next -> Read_DT_PND_next_AD_PND_prev;

    Read_DT_PND_next_AD_PND_prev -> Read_DT_PND_next_AD_PND_prev [label=<WAIT>];
    Read_DT_PND_next_AD_PND_prev -> Read_DT_PND_prev [label=<READY>];
    Read_DT_PND_next_AD_PND_prev -> Error [label=<ERROR>];
    Read_DT_PND_next_AD_PND_prev -> Retract [label=<RETRACT>];

    Read_DT_PND_prev -> Read_DT_PND_prev [label=<WAIT>];
    Read_DT_PND_prev -> Compare_next_prev [label=<READY>];
    Read_DT_PND_prev -> Error [label=<ERROR>];
    Read_DT_PND_prev -> Retract [label=<RETRACT>];

    Compare_next_prev -> Write_AD_PND [label=<Same>];
    Compare_next_prev -> Write_AD_PND_prev_next [label=<<o>Same</o>>];

    Write_AD_PND -> Write_DT_NULL_AD_PND_Lock;

    Write_DT_NULL_AD_PND_Lock -> Write_DT_NULL_AD_PND_Lock [label=<WAIT>];
    Write_DT_NULL_AD_PND_Lock -> Write_DT_0 [label=<READY>];
    Write_DT_NULL_AD_PND_Lock -> Error [label=<ERROR>];
    Write_DT_NULL_AD_PND_Lock -> Retract [label=<RETRACT>];

    Write_AD_PND_prev_next -> Write_DT_next_AD_PND_next_prev;

    Write_DT_next_AD_PND_next_prev -> Write_DT_next_AD_PND_next_prev [label=<WAIT>];
    Write_DT_next_AD_PND_next_prev -> Write_DT_prev_AD_PND [label=<READY>];
    Write_DT_next_AD_PND_next_prev -> Error [label=<ERROR>];
    Write_DT_next_AD_PND_next_prev -> Retract [label=<RETRACT>];

    Write_DT_prev_AD_PND -> Write_DT_prev_AD_PND [label=<WAIT>];
    Write_DT_prev_AD_PND -> Write_DT_next_AD_PND_Lock [label=<READY>];
    Write_DT_prev_AD_PND -> Error [label=<ERROR>];
    Write_DT_prev_AD_PND -> Retract [label=<RETRACT>];

    Write_DT_next_AD_PND_Lock -> Write_DT_next_AD_PND_Lock [label=<WAIT>];
    Write_DT_next_AD_PND_Lock -> Write_DT_0 [label=<READY>];
    Write_DT_next_AD_PND_Lock -> Error [label=<ERROR>];
    Write_DT_next_AD_PND_Lock -> Retract [label=<RETRACT>];

    Write_DT_0 -> Write_DT_0 [label=<WAIT>];
    Write_DT_0 -> OK [label=<READY>];
    Write_DT_0 -> Error [label=<ERROR>];
    Write_DT_0 -> Retract [label=<RETRACT>];

    Error -> Idle;
    Retract -> Idle;
    OK -> Idle;
}
